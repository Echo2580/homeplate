# 复制本文件为 .env 并填入你的真实信息（.env 已被 .gitignore 挡住，不会上传 GitHub）
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/homeplate?charset=utf8mb4

# 铭牌识别模型配置（任意 OpenAI 兼容端点均可，换供应商只改这三行）
# DeepSeek：AI_API_BASE=https://api.deepseek.com          模型 deepseek-flash
# 阿里百炼：AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-vl-plus
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=sk-在这里填你的APIKey
VISION_MODEL=deepseek-flash

# 访问密码（公网部署时启用：整站需要输入密码；留空则不启用）
# 浏览器弹出原生登录框时，用户名随便填，密码填这个
ACCESS_PASSWORD=
